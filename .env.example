# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Nothing here is required for local development: the backend defaults to the
# `console` email provider, which prints login codes to the server log instead
# of sending mail.

# Email delivery. `console` (default) logs the OTP; `brevo` sends real email.
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_SENDER=noreply@stockup.local

# Signing key for JWTs. The built-in default is development-only —
# set a long random value for anything reachable from the internet.
JWT_SECRET=

# Grants ADMIN to this account on boot. The user must already exist,
# i.e. have signed in once with this email.
ADMIN_EMAIL=
