# Copy to .env and fill in. .env is gitignored and is loaded automatically by
# the backend (see spring.config.import in application.yaml) — you do not need
# to export anything by hand.
#
# IMPORTANT: leave a variable COMMENTED OUT to use its built-in default.
# Setting it to an empty value (FOO=) overrides the default with an empty
# string rather than falling back to it, which will break startup.
#
# Nothing here is required to run locally: the app defaults to the `console`
# email provider, which prints login codes to the server log.

# Email delivery.
#   console — print the login code to the server log (default, no account needed)
#   brevo   — send real email; needs a live key and a VERIFIED sender
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your-brevo-key
# EMAIL_SENDER=verified-sender@example.com

# Signing key for JWTs. The built-in default is development-only —
# set a long random value for anything reachable from the internet.
# JWT_SECRET=a-long-random-value

# Grants ADMIN to this account on boot. The user must already exist,
# i.e. have signed in once with this email.
# ADMIN_EMAIL=you@example.com
